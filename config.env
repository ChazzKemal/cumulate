# Shared connection settings. Same for everyone, none of them secret - the
# publishable key is designed to ship to clients, and row-level security is what
# actually protects the data.
#
# Personal settings live in the workspace's own .env, which overrides anything
# here. Never put a secret key in this file: it is committed and everyone gets it.
SUPABASE_URL=https://qxdtkrsyozmpbecyccjb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_WBkhbCcAdTk1QEAW82N0bg_HL8RX5bz
CUMULATE_REDIRECT=http://localhost:8501
CUMULATE_KEY_ENDPOINT=https://qxdtkrsyozmpbecyccjb.supabase.co/functions/v1/issue-key

# The gateway (harvest/gateway): when set, Codex talks to it instead of to
# OpenAI, and everyone's key is a personal gateway key with its own budget.
# Anyone still holding an old key is re-issued one automatically at next start.
# No trailing slash.
# CUMULATE_GATEWAY=https://gateway.example.com
#
# The model everyone uses. Unset, Codex uses whatever each person's own Codex
# settings say. With the gateway, this can be any model it serves.
# CUMULATE_MODEL=
